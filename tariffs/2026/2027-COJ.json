  "billing_rules": {
    "reactive_energy": {
      "applies_to": [
        "industrial_lv",
        "industrial_mv",
        "industrial_lv_tou",
        "industrial_mv_tou"
      ],
      "pf_threshold": 0.96,
      "free_allowance_fraction_of_kwh": 0.3,
      "period": "entire billing period (totals, not per interval or per TOU period)",
      "formula": "chargeable_kvarh = max(0, total_kvarh_supplied - 0.30 * total_kwh); charge_rand = chargeable_kvarh * rate_c_per_kvarh / 100",
      "notes": [
        "Source (4.4.1): customers with PF below 0.96 are billed for reactive energy supplied in excess of 30% (0.96 PF) of total kWh for the billing period. The rate is NOT applied to total kVArh.",
        "Only the 30% test is needed; the PF check is the same condition (30% kVArh:kWh ~ PF 0.958, rounded to 0.96 in the source).",
        "Stated identically for the LPU tariffs (4.4.1) and the Industrial TOU tariffs (5.4.1) in the FY25/26 annexure, so it applies to all four."
      ]
    },
    "minimum_demand": {
      "applies_to_confirmed": [
        "industrial_lv",
        "industrial_mv",
        "industrial_lv_tou",
        "industrial_mv_tou"
      ],
      "applies_to_presumed": [],
      "rule": "billed_demand_kva = max(measured_demand_kva, 70, 0.80 * average(three highest demands in the preceding 12 months))",
      "components_kva": [
        {
          "type": "actual_measured_demand"
        },
        {
          "type": "fixed",
          "kva": 70
        },
        {
          "type": "preceding_12m_top3_average_fraction",
          "fraction": 0.8
        }
      ],
      "charge": "demand_charge_rand = billed_demand_kva * demand_r_per_kva",
      "notes": [
        "Stated identically under Large Consumers (4.3.1) and Industrial TOU (5.3.1) in the FY25/26 annexure.",
        "The 80% look-back component has applied since 1 July 2021. The source does not say whether 'three highest demands' means monthly billed maxima; the standard reading is the three highest monthly maximum demands.",
        "The demand charge is the same in summer and winter (R423.10 both seasons in FY25/26), so a single all-season rate is stored."
      ]
    },
    "prepaid": {
